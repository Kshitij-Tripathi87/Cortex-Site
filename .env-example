# Cortex Marketing Platform v1 — environment template.
# Copy to .env for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
SITE_URL=https://cortex.systems

# ---------------------------------------------------------------------------
# Admin (private /admin/waitlist dashboard; server-side httpOnly session)
# ---------------------------------------------------------------------------
WORKFLO_ADMIN_TOKEN=change-me-to-a-long-random-token

# ---------------------------------------------------------------------------
# Email (Resend). Use "mock" locally to log instead of sending.
# ---------------------------------------------------------------------------
WORKFLO_EMAIL_MODE=mock
RESEND_API_KEY=
WORKFLO_WAITLIST_TO_EMAIL=
WORKFLO_EMAIL_FROM=
CORTEX_CONTACT_TO_EMAIL=
CORTEX_CONTACT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Supabase (optional until provisioned — server falls back to data/*.json).
# SERVICE_ROLE_KEY IS SERVER-ONLY. Never prefix it with VITE_ or expose it.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI Core (optional — grounded fallback answers when unset)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Local JSON store overrides (defaults under ./data/)
# ---------------------------------------------------------------------------
WORKFLO_WAITLIST_FILE=
CORTEX_CONTACT_FILE=
CORTEX_DEMO_FILE=
CORTEX_NEWSLETTER_FILE=
CORTEX_ANALYTICS_FILE=
