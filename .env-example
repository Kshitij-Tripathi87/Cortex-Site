# Cortex local development environment
# Never commit real credentials. Production secrets belong in Render protected env vars.

NODE_ENV=development
PORT=3000

# Supabase — server only. Leave blank for local JSON development fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server only. Use mock mode locally when provider access is unavailable.
RESEND_API_KEY=
CORTEX_EMAIL_MODE=mock
CORTEX_CONTACT_TO_EMAIL=
CORTEX_CONTACT_EMAIL_FROM=
CORTEX_WAITLIST_TO_EMAIL=
CORTEX_EMAIL_FROM=

# Remote Ollama-compatible endpoint. Leave blank locally to use grounded fallback.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# Local-only file paths used when Supabase is not configured.
WORKFLO_WAITLIST_FILE=data/waitlist.json
CORTEX_CONTACT_FILE=data/contacts.json
CORTEX_DEMO_FILE=data/demos.json
CORTEX_NEWSLETTER_FILE=data/newsletter.json
CORTEX_ANALYTICS_FILE=data/analytics.json
