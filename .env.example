# ─────────────────────────────────────────────────────────────
# Cortex-Site — Environment Variable Contract
# Issue #9: Render deployment contract
#
# Copy this file to `.env` for local development.
# NEVER commit real secrets. All secrets live in Render's
# environment configuration or `render secret set`.
# ─────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase (persistence) ──────────────────────────────────
# Required in production. In development, the server falls back
# to local JSON files when these are absent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (email delivery) ─────────────────────────────────
# Set WORKFLO_EMAIL_MODE=resend to enable real email.
# Omit or set to "mock" for development (logs to console).
RESEND_API_KEY=
WORKFLO_EMAIL_MODE=mock

# ── Email routing ───────────────────────────────────────────
# Who receives contact-form notifications.
CORTEX_CONTACT_TO_EMAIL=admin@example.com
# Sender address for contact emails.
CORTEX_CONTACT_EMAIL_FROM=noreply@example.com
# Who receives waitlist sign-up notifications.
WORKFLO_WAITLIST_TO_EMAIL=admin@example.com
# Sender address for waitlist emails.
WORKFLO_EMAIL_FROM=noreply@example.com

# ── Admin authentication ────────────────────────────────────
# Shared secret for the admin dashboard login.
# Generate with: openssl rand -hex 32
WORKFLO_ADMIN_TOKEN=

# ── Ollama (AI chat) ────────────────────────────────────────
# Base URL of your remote Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434
# Model name to use for chat completions.
OLLAMA_MODEL=llama3

# ── Local JSON file paths (development fallback only) ──────
# These are used when Supabase is not configured.
# In production, Supabase is authoritative.
WORKFLO_WAITLIST_FILE=data/waitlist.json
CORTEX_CONTACT_FILE=data/contacts.json
CORTEX_DEMO_FILE=data/demos.json
CORTEX_NEWSLETTER_FILE=data/newsletter.json
CORTEX_ANALYTICS_FILE=data/analytics.json
