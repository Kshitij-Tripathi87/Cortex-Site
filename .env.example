# Set to "mock" for local testing; leave as "resend" (or omit) in production.
WORKFLO_EMAIL_MODE=resend

# Resend API key. Keep this value server-side and never expose it in client code.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender identity in Resend, for example: Workflo <waitlist@yourdomain.com>
WORKFLO_EMAIL_FROM=Workflo <waitlist@your-verified-domain.com>

# Inbox that should receive each Workflo early-access request.
WORKFLO_WAITLIST_TO_EMAIL=you@company.com

# Admin credential for the private dashboard at /admin/waitlist. Submitted
# once at /api/admin/login; the server then issues an httpOnly session
# cookie and never re-exposes this value to the browser. Use a long random
# value and rotate it periodically.
WORKFLO_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional server port.
PORT=3000

# Set to "production" when deploying so admin session cookies are marked
# Secure (HTTPS-only). Most hosts set this automatically.
NODE_ENV=production
